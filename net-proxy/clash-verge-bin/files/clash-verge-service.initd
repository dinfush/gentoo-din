#!/sbin/openrc-run
description="Clash Verge Core Service for TUN/TAP routing"

command="/usr/bin/clash-verge-service"
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
    need net
    after firewall
}

start_pre() {
    modprobe tun 2>/dev/null || true
    checkpath -d -m 0755 /var/log/clash-verge
}
